{
  "name": "dsh-mcp-bar",
  "version": "0.1.0",
  "description": "DeepSeek Harness MCP 管理插件：输入框上方的 MCP 状态栏 + 完整的服务器管理面板。表单 / JSON 添加，启停、编辑、删除、连接测试与工具查看，配置持久化并接管 profile 中的原生 mcp-client 条目。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "node --check lib/args.js && node --check lib/index.js && node --check lib/client.js && node --check lib/web.js && node --check lib/store.js && node --check lib/record.js && node --check lib/json-import.js && node --check lib/probe.js && node --check lib/provision.js && node --check lib/native.js && node --check scripts/ui-harness.mjs && node --check scripts/harness/harness.js && node --check scripts/harness/mock-api.js",
    "dev:ui": "node scripts/ui-harness.mjs",
    "check": "npm run lint && npm test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mcp",
    "mcp-manager",
    "mcp-bar",
    "model-context-protocol",
    "mcp-client",
    "stdio",
    "streamable-http",
    "plugin"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-ui-layout": "*",
    "@deepseek-ai/dsh-mcp-client": "^0.1.1-rc.2 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
